{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "multiplist"
  ],
  "name": "multiplist",
  "title": "Multiplist Sovereign Memory & Studio MCP Hub",
  "description": "Connect Claude, Antigravity, and frontier LLMs directly to your sovereign Vault, living marginalia, and autonomous Studio runways.",
  "icon": "https://multiplist.ai/assets/Multiplist-logo-D-1c-KCu.png",
  "package": "@multiplist/mcp-server",
  "transport": "stdio",
  "command": "npx",
  "args": [
    "-y",
    "@multiplist/mcp-server@latest"
  ],
  "env": {
    "MULTIPLIST_MCP_TOKEN": {
      "description": "Your Multiplist Sovereign MCP token (from https://multiplist.ai/settings)",
      "required": true
    }
  },
  "tools": [
    "create_source",
    "update_source",
    "delete_source",
    "trigger_extraction",
    "get_source",
    "search_vault",
    "search_sources",
    "get_vault_summary",
    "get_vault_gaps",
    "get_capabilities",
    "list_local_models",
    "query_local_model",
    "compose_workspace",
    "resolve_workspace",
    "list_containers",
    "create_container",
    "update_container",
    "delete_container",
    "get_container",
    "get_container_structure",
    "get_container_stats",
    "list_studios",
    "create_studio",
    "update_studio",
    "delete_studio",
    "get_deck_state",
    "pin_source",
    "unpin_source",
    "list_pins",
    "list_lanes",
    "create_lane",
    "update_lane",
    "delete_lane",
    "get_lane_contents",
    "list_cards",
    "get_card",
    "create_card",
    "update_card",
    "move_card",
    "delete_card",
    "graduate_card",
    "request_brief",
    "get_brief_status",
    "create_vault_folder",
    "delete_vault_folder",
    "rename_vault_folder",
    "add_sources_to_folder",
    "remove_source_from_folder",
    "batch_extract",
    "batch_status",
    "create_skill",
    "list_skills",
    "get_skill",
    "match_skills",
    "update_skill",
    "delete_skill",
    "add_annotation",
    "add_marginalia",
    "list_source_assets",
    "rescue_excerpt",
    "scaffold_agent_runway",
    "get_desk_state",
    "query_agent_log",
    "list_production_skills",
    "produce_deliverable",
    "get_context",
    "list_realms",
    "get_current_realm",
    "switch_realm",
    "share_source_to_realm",
    "move_source_to_realm",
    "update_source_metadata",
    "diagnose_source",
    "prune_source_tree",
    "query_database"
  ]
}
